# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=banglaqr_db
DB_USER=root
DB_PASSWORD=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Authentication & Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters
COOKIE_SECRET=your_cookie_secret_minimum_32_characters
OTP_HASH_SECRET=your_otp_hmac_secret_minimum_32_characters

# Real Email Delivery (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="BanglaQR Security" <noreply@banglaqr.com>

# Real SMS Delivery (Bangladesh SMS Providers)
# Options: bulksmsbd | greenweb | elitbuzz | generic_http | twilio
SMS_PROVIDER=bulksmsbd
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=BanglaQR

# Local Development Verification Mode
# Options: development_bypass (strictly active only when NODE_ENV=development)
AUTH_VERIFICATION_MODE=development_bypass
